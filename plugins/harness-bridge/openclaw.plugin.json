{
  "id": "harness-bridge",
  "name": "Harness Bridge",
  "description": "Gives OpenClaw verified Harness workspace, Gmail, Calendar, cron, and Saju tools",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "harness_saju_query",
      "harness_smartfarm_pump_control",
      "harness_knowledge_query",
      "harness_alpaca_status",
      "harness_workspace_stats",
      "harness_workspace_read",
      "harness_workspace_search",
      "harness_workspace_write",
      "harness_workspace_exec",
      "harness_copilot_usage",
      "harness_gmail_search",
      "harness_gmail_get",
      "harness_calendar_list",
      "harness_calendar_create",
      "harness_notion_archive_create",
      "harness_cron_list",
      "harness_cron_create",
      "harness_cron_remove"
    ]
  },
  "skills": [
    "./skills"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ownerSenderIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "default": []
      },
      "ownerSessionKeys": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "default": []
      }
    }
  }
}
